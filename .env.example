# FieldTrack — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Base URL of your backend REST API (no trailing slash)
API_BASE_URL=https://your-api.example.com

# API path prefix
API_PATH=/api/v1

# URL of the web frontend (used for trusted-origin whitelist)
WEB_APP_URL=https://your-webapp.example.com

# Set to "production" for release builds
NODE_ENV=production
